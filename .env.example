# Copy to .env on the server. Read by docker compose.
BASE_DOMAIN=example.com

# Traefik (defaults shown)
# TRAEFIK_NETWORK=traefik
# TRAEFIK_ENTRYPOINT=websecure
# TRAEFIK_CERTRESOLVER=letsencrypt

# Upload limits in bytes (defaults shown)
# MAX_UPLOAD=52428800
# MAX_UNZIPPED=209715200
# MAX_FILES=10000

# Local dev only (not used by compose)
# ADDR=localhost:8080
# SITES_DIR=.sites
